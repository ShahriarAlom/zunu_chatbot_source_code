# Zunu AI Chatbot - Environment Configuration Template
# Copy this file to '.env' and populate with your credentials before building/starting containers.

# 1. Google Gemini API Configuration (Required for AI responses)
# Retrieve your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Security Configuration
# Shared JWT secret key used to sign and verify secure session tokens from Laravel.
# Leave empty or omit to disable JWT validation in development/local mode.
JWT_SECRET=

# 3. Database Configuration (Method A: Easy Laravel-Style individual variables)
# Use this method if your database passwords contain special characters (like ;, !, }, @)
# to avoid database connection string parser crashes. The code will URL-encode credentials automatically.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=rdadmin_dev
DB_PASSWORD=
DB_DATABASE=rdadmin_dev_realdealride

CHATBOT_DB_HOST=127.0.0.1
CHATBOT_DB_PORT=3307
CHATBOT_DB_USERNAME=root
CHATBOT_DB_PASSWORD=password
CHATBOT_DB_DATABASE=realdealride_ai

# 4. Database Configuration (Method B: Direct SQLAlchemy Connection URIs)
# Alternatively, configure complete connection URIs directly.
# NOTE: Special characters in passwords must be URL-encoded manually:
# MARIADB_URI=mysql+aiomysql://root:password@localhost:3307/realdealride_ai
# LARAVEL_DB_URI=mysql+aiomysql://rdadmin_dev:b%21vq%3BN%7DNjFJ1@localhost:3306/rdadmin_dev_realdealride

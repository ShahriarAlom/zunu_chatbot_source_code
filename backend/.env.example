# Junu AI Chatbot - Environment Configuration Template
# Copy this file to '.env' and populate with your credentials before building/starting containers.

# 1. Google Gemini API Configuration (Required for AI responses)
# Retrieve your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Database Configuration
# URIs use SQLalchemy + aiomysql async wrapper.
# Formatting: mysql+aiomysql://<user>:<password>@<host>:<port>/<db_name>

# The AI Chatbot Vector & Session Database
MARIADB_URI=mysql+aiomysql://root:password@mariadb_chatbot:3306/realdealride_ai

# The Live Laravel / XAMPP Database Connection
LARAVEL_DB_URI=mysql+aiomysql://rdadmin_dev:b%21vq%3BN%7DNjFJ1@laravel_db_simulator:3306/rdadmin_dev_realdealride

# 3. Security Configuration
# Shared JWT secret key used to sign and verify secure session tokens from Laravel.
# Leave empty or omit to disable JWT validation in development mode.
JWT_SECRET=
